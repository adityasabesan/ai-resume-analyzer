STOPWORDS = {
    "a", "an", "and", "the", "is", "are", "was", "were", "to", "for", "of", "in", "on", "with",
    "at", "by", "from", "or", "as", "be", "this", "that", "it", "your", "you", "will", "can",
    "have", "has", "had", "not", "but", "if", "their", "they", "we", "our", "us", "i", "me",
    "my", "about", "into", "than", "then", "them", "he", "she", "his", "her"
}

COMMON_SKILLS = [
    "python", "java", "c", "c++", "javascript", "typescript", "html", "css", "sql",
    "machine learning", "deep learning", "nlp", "data analysis", "pandas", "numpy",
    "matplotlib", "scikit-learn", "tensorflow", "pytorch", "streamlit", "flask",
