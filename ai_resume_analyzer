ACTION_VERBS = [
    "developed", "built", "designed", "implemented", "optimized", "created", "led",
    "improved", "analyzed", "automated", "tested", "deployed", "engineered", "managed",
    "trained", "collaborated", "integrated", "streamlined"
]

def clean_text(text):
    if not text:
        return ""
    text = text.lower()
    text = re.sub(r"[^a-z0-9+#.\s]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text

def extract_text_from_pdf(uploaded_file):
    try:
        reader = PdfReader(uploaded_file)
        text = ""
        for page in reader.pages:
            extracted = page.extract_text()
            if extracted:
                text += extracted + "\n"
        return text
    except Exception:
        return ""

def extract_text_from_docx(uploaded_file):
    try:
        doc = Document(uploaded_file)
        return "\n".join([para.text for para in doc.paragraphs])
    except Exception:
        return ""

def extract_text(uploaded_file):
    file_name = uploaded_file.name.lower()

    if file_name.endswith(".pdf"):
        return extract_text_from_pdf(uploaded_file)
    elif file_name.endswith(".docx"):
        return extract_text_from_docx(uploaded_file)
    elif file_name.endswith(".txt"):
        return uploaded_file.read().decode("utf-8", errors="ignore")
    return ""

def tokenize(text):
    text = clean_text(text)
    words = text.split()
    return [word for word in words if word not in STOPWORDS and len(word) > 2]

def get_top_keywords(text, top_n=15):
    words = tokenize(text)
    freq = Counter(words)
    return freq.most_common(top_n)

def extract_skills(text):
    text_clean = clean_text(text)
    found_skills = []
    for skill in COMMON_SKILLS:
        if skill.lower() in text_clean:
            found_skills.append(skill)
    return sorted(list(set(found_skills)))

def keyword_match_score(resume_text, jd_text):
    resume_words = set(tokenize(resume_text))
    jd_words = set(tokenize(jd_text))

    if not jd_words:
        return 0, [], []

    matched = sorted(list(resume_words.intersection(jd_words)))
    missing = sorted(list(jd_words - resume_words))

    score = int((len(matched) / len(jd_words)) * 100)
    return score, matched[:50], missing[:50]

def detect_sections(resume_text):
    text = resume_text.lower()
    sections = {
        "education": "education" in text,
        "experience": "experience" in text or "internship" in text or "work history" in text,
        "projects": "projects" in text or "project" in text,
        "skills": "skills" in text or "technical skills" in text,
        "certifications": "certification" in text or "certifications" in text,
        "summary": "summary" in text or "profile" in text or "objective" in text
    }
    return sections

def check_resume_quality(resume_text):
    text = resume_text.lower()
    suggestions = []

    # Length check
    word_count = len(text.split())
    if word_count < 200:
        suggestions.append("Your resume looks too short. Add more project details, internships, and achievements.")
    elif word_count > 1000:
        suggestions.append("Your resume may be too long. Try keeping it more concise and focused.")

    # Email check
    if not re.search(r'[\w\.-]+@[\w\.-]+\.\w+', resume_text):
        suggestions.append("Add a professional email address.")

    # Phone check
    if not re.search(r'(\+?\d[\d\s\-]{8,})', resume_text):
        suggestions.append("Add a phone number.")

    # LinkedIn / GitHub check
    if "linkedin" not in text:
        suggestions.append("Add your LinkedIn profile.")
    if "github" not in text:
        suggestions.append("Add your GitHub profile.")

    # Action verbs check
    found_action_verbs = [verb for verb in ACTION_VERBS if verb in text]
    if len(found_action_verbs) < 3:
        suggestions.append("Use stronger action verbs like Developed, Built, Implemented, Optimized.")

    # Numbers / impact check
    if not re.search(r'\b\d+%|\b\d+\b', resume_text):
        suggestions.append("Add measurable achievements using numbers, percentages, or counts.")

    # Sections check
    sections = detect_sections(resume_text)
    for sec, present in sections.items():
        if not present:
            suggestions.append(f"Consider adding a {sec.title()} section.")

    return suggestions

def score_label(score):
    if score >= 80:
        return "Excellent Match ✅"
    elif score >= 60:
        return "Good Match 👍"
    elif score >= 40:
        return "Average Match ⚠️"
    return "Low Match ❌"

